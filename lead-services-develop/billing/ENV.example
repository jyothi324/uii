# SaaS Billing — environment variables (lead-services)

# Control-plane DB (defaults: same host/user/password as tenant DBs, dbname=tulip_control)
CONTROL_PLANE_DB_NAME=tulip_control

# Stripe (test keys for local)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...

# Redirects after Checkout / Portal
# Use {subdomain} so each tenant returns to app.localhost / tampa.localhost (port 80, no :3000).
# Keep {CHECKOUT_SESSION_ID} exactly — Stripe replaces it.
STRIPE_SUCCESS_URL=http://{subdomain}.localhost/settings?billing=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://{subdomain}.localhost/settings?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://{subdomain}.localhost/settings

# Production example:
# STRIPE_SUCCESS_URL=https://{subdomain}.tulipcrm.com/settings?billing=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://{subdomain}.tulipcrm.com/settings?billing=cancel
# STRIPE_PORTAL_RETURN_URL=https://{subdomain}.tulipcrm.com/settings

# Existing DB_* vars are reused for control-plane host/user/password/port
